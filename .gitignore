# Consolidated out-of-source build tree (per-component .o files, the
# kernel ELF, initramfs staging tree, initramfs.cpio, libc.so,
# ld-rtmux.so, drivers, and host tools). Every Makefile drops outputs
# under $(BUILD_DIR), mirroring the source-tree layout.
/build/

# Kconfiglib (cloned on demand by 'make defconfig' / 'make menuconfig')
/tools/kconfig/

# Prebuilt LKL artifacts (rv64 toolchain output). Built or extracted by
# scripts/build-lkl-rv64.sh (--build-from-source an LKL tree, or --extract a
# tarball), never committed.
/prebuilt/

# Script for U-Boot (generated)
boot/boot.scr
