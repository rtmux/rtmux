# rtmux LKL config overlay for the lkl-netd personality: IPv4 networking, no ext4.
# Applied on top of configs/lkl-rtmux.config by scripts/build-lkl-rv64.sh
# --build-from-source when LKL_PERSONALITY=netd.
#
# netd uses upstream LKL virtio_net.o with RTMux's delegated virtio-mmio backend.
# Keep the generic fs/block glue because utils.o and virtio.o reference fs.o /
# virtio_blk.o symbols even though netd never mounts anything.
# CONFIG_EXT4_FS is not set
CONFIG_VIRTIO=y
CONFIG_VIRTIO_NET=y
