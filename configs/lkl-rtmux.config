# rtmux LKL kernel config fragment, merged into the LKL .config by
# scripts/build-lkl-rv64.sh --build-from-source (override with LKL_CONFIG_FRAGMENT).
#
# Keep this to options that shape the archive rtmux ships without changing its
# behaviour: size/optimization and debug knobs.  Fortify and stack-protector are
# forced off via CFLAGS/KCFLAGS in the build script (they come from the distro
# cross-gcc defaults, not the config), so they are not repeated here.

# Optimize the kernel text for size (-Os); measurably smaller servers with no
# functional change.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# No kernel debug info -- the archive is stripped and the servers are stripped on
# install, so this only bloats the intermediate objects and the build.
# CONFIG_DEBUG_INFO is not set

# Prune subsystems rtmux's LKL personalities do not use.  The LKL defconfig turns
# these on; drop them so a from-source archive matches the shipped one's size.
# No consumer returns without an explicit cap + test (see AGENTS/TODO non-goals).
# CONFIG_PCI is not set
# CONFIG_IPV6 is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_FAT_FS is not set
